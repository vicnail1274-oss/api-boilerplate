{
  "name": "api-boilerplate",
  "version": "0.1.0",
  "private": false,
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "test": "vitest",
    "test:cover": "vitest --coverage",
    "lint": "eslint src --ext .ts",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
