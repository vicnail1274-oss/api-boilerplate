    "winston": "^3.12.0",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "typescript": "^5.4.2",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.11.24",
    "tsx": "^4.7.1",
    "prisma": "^5.10.0",
    "vitest": "^1.3.1",
    "supertest": "^6.3.4",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^1.3.1",
